{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pc-telemetry:v1:telemetry",
  "title": "Telemetry v1 draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "version",
    "deviceId",
    "sessionId",
    "sequence",
    "sampledAt",
    "mode",
    "gpu",
    "metrics"
  ],
  "properties": {
    "type": {
      "const": "telemetry"
    },
    "version": {
      "const": 1
    },
    "deviceId": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sampledAt": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": [
        "live",
        "demo"
      ]
    },
    "gpu": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "id",
        "name",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "discrete",
            "integrated",
            "unknown"
          ]
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpuUsage",
        "gpuUsage",
        "ram",
        "vram",
        "cpuTemperature",
        "gpuTemperature"
      ],
      "properties": {
        "cpuUsage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "status",
            "sampledAt",
            "source"
          ],
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "status": {
              "enum": [
                "ok",
                "stale",
                "unavailable"
              ]
            },
            "sampledAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "source": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "unavailable"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "null"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "ok",
                      "stale"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "number"
                  },
                  "sampledAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          ]
        },
        "gpuUsage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "status",
            "sampledAt",
            "source"
          ],
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "status": {
              "enum": [
                "ok",
                "stale",
                "unavailable"
              ]
            },
            "sampledAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "source": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "unavailable"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "null"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "ok",
                      "stale"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "number"
                  },
                  "sampledAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          ]
        },
        "ram": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "usedBytes",
            "totalBytes",
            "percent",
            "status",
            "sampledAt",
            "source"
          ],
          "properties": {
            "usedBytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "totalBytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "percent": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "status": {
              "enum": [
                "ok",
                "stale",
                "unavailable"
              ]
            },
            "sampledAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "source": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "vram": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "usedBytes",
            "totalBytes",
            "percent",
            "status",
            "sampledAt",
            "source"
          ],
          "properties": {
            "usedBytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "totalBytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "percent": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "status": {
              "enum": [
                "ok",
                "stale",
                "unavailable"
              ]
            },
            "sampledAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "source": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "cpuTemperature": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "status",
            "sampledAt",
            "source"
          ],
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "status": {
              "enum": [
                "ok",
                "stale",
                "unavailable"
              ]
            },
            "sampledAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "source": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "unavailable"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "null"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "ok",
                      "stale"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "number"
                  },
                  "sampledAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          ]
        },
        "gpuTemperature": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "status",
            "sampledAt",
            "source"
          ],
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "status": {
              "enum": [
                "ok",
                "stale",
                "unavailable"
              ]
            },
            "sampledAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "source": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "unavailable"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "null"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "ok",
                      "stale"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "number"
                  },
                  "sampledAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
